# 凭据与运行时状态（严禁提交）
.env
.env.*
!.env.example
# 宝塔官方应用商店模板里的 .env 是样例配置（端口 / 占位符 / 官方默认值），不是凭据，
# 必须随模板一起入库，否则 clone 后应用商店全部缺配置文件。与 scripts/remote.js 的
# 部署排除规则保持一致：只排除仓库根凭据，子目录模板放行。
!platform/appstore/**/.env
data/
state.json
state.json.tmp
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.log

# 依赖与构建产物
node_modules/
dist/
build/
*.tar.gz
*.tgz
*.tmp
.DS_Store
Thumbs.db

# 工作区：克隆的仓库、构建产物、部署测试目录
workspace/*
!workspace/.gitkeep

# Windows 原生集成服务：下载的二进制、Gitea 仓库、OpenList 数据、日志与 PID
windows/runtime/
windows/bin/
.native-probe/

# 预构建分发包（CI 产物 / 本机离线包，体积大，不入库；由 GitHub Release 分发）
windows/bootstrap/*.zip
windows/bootstrap/SHA256SUMS.txt
windows/bootstrap/*.exe
/devplatform-dist.zip
/devplatform-windows.zip
/devplatform.exe
/SHA256SUMS.txt

# 本地 AI 工作记录与平台运行工作区（含本机凭据、调试日志、测试产物，不入库）
.workbuddy/
platform/workspace/
