# 凭据与运行时状态（严禁提交）
.env
.env.*
!.env.example
data/
state.json
state.json.tmp
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.log

# 依赖与构建产物
node_modules/
dist/
build/
*.tar.gz
*.tgz
*.tmp
.DS_Store
Thumbs.db

# 工作区：克隆的仓库、构建产物、部署测试目录
workspace/*
!workspace/.gitkeep

# Windows 原生集成服务：下载的二进制、Gitea 仓库、OpenList 数据、日志与 PID
windows/runtime/
windows/bin/
.native-probe/

# 预构建分发包（CI 产物 / 本机离线包，体积大，不入库；由 GitHub Release 分发）
windows/bootstrap/*.zip
windows/bootstrap/SHA256SUMS.txt
